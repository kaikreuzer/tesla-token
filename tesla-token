#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
MAVEN_REPO_LOCAL="${MAVEN_REPO_LOCAL:-$HOME/.m2/repository}"
CLASSPATH_FILE="${CLASSPATH_FILE:-$SCRIPT_DIR/target/classpath.txt}"

if [ -z "${JAVA_HOME:-}" ]; then
  if command -v /usr/libexec/java_home >/dev/null 2>&1; then
    JAVA_HOME=$(/usr/libexec/java_home -v 21 2>/dev/null || true)
  fi
fi

if [ -n "${JAVA_HOME:-}" ]; then
  export JAVA_HOME
  export PATH="$JAVA_HOME/bin:$PATH"
fi

mvn \
  -f "$SCRIPT_DIR/pom.xml" \
  -Dmaven.repo.local="$MAVEN_REPO_LOCAL" \
  -DskipTests \
  compile \
  dependency:build-classpath \
  -Dmdep.outputFile="$CLASSPATH_FILE" \
  -Dmdep.includeScope=runtime \
  >/dev/null

APP_CP="$SCRIPT_DIR/target/classes:$(cat "$CLASSPATH_FILE")"
JAVA_ARGS=""
if [ "$(uname -s)" = "Darwin" ]; then
  JAVA_ARGS="-XstartOnFirstThread"
fi

exec java $JAVA_ARGS -cp "$APP_CP" de.kaikreuzer.teslatoken.TeslaToken "$@"
